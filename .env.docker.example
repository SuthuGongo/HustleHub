# Copy this file to ".env" (next to docker-compose.yml) and replace both values.
# Generate each secret with:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (or, on Linux/macOS:         openssl rand -hex 32)

# Signs login tokens. Use a long random value. Never commit the real .env file.
JWT_SECRET=replace_with_a_long_random_value

# Password for the MongoDB root user inside the compose network. Letters and numbers only.
MONGO_PASSWORD=replace_with_a_random_value

# Optional: real email for verification and reset codes. Leave blank to read the codes from
#   docker compose logs backend
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=HustleHub+ <no-reply@example.com>
# NODE_ENV=production
