{
  "name": "backend",
  "version": "1.0.0",
  "description": "HustleHub+ secure freelance marketplace API (Node.js, Express, MongoDB)",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "gen-cert": "node scripts/generateCert.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "demo:tamper-audit": "node scripts/tamperAuditDemo.js",
    "security:probe": "node scripts/securityProbe.js",
    "test:api": "node scripts/runNewman.js",
    "test:api:coverage": "node scripts/runNewman.js --coverage",
    "test:unit": "jest",
    "test:unit:coverage": "jest --coverage --coverageReporters=lcovonly --coverageReporters=text-summary --coverageDirectory=coverage-jest",
    "build": "node -e \"require('./src/app.js'); console.log('Backend loads cleanly: all routes, controllers and middleware wired without error.')\"",
    "lint": "eslint .",
    "sync:refunds": "node scripts/syncRefundedTransactions.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.11.0",
    "nodemailer": "^10.0.10",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14"
  }
}
